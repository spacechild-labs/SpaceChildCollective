<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spaceGradient16" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#764ba2;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f093fb;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Outer ring -->
  <circle cx="8" cy="8" r="7" fill="none" stroke="url(#spaceGradient16)" stroke-width="1" opacity="0.6"/>
  
  <!-- Inner hexagon -->
  <path d="M 8,2 L 12,4.5 L 12,9.5 L 8,12 L 4,9.5 L 4,4.5 Z" 
        fill="url(#spaceGradient16)" opacity="0.8"/>
  
  <!-- Center consciousness node -->
  <circle cx="8" cy="8" r="2" fill="#00f2fe" opacity="0.9"/>
  
  <!-- Orbital nodes -->
  <circle cx="8" cy="2" r="1" fill="#f093fb" opacity="0.9"/>
  <circle cx="12" cy="4.5" r="1" fill="#764ba2" opacity="0.9"/>
  <circle cx="12" cy="9.5" r="1" fill="#667eea" opacity="0.9"/>
  <circle cx="8" cy="12" r="1" fill="#4facfe" opacity="0.9"/>
  <circle cx="4" cy="9.5" r="1" fill="#667eea" opacity="0.9"/>
  <circle cx="4" cy="4.5" r="1" fill="#764ba2" opacity="0.9"/>
</svg>
