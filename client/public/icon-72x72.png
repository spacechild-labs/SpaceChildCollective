<svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spaceGradient72" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#764ba2;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fecfef;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="consciousnessGlow72" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00f2fe;stop-opacity:0.9" />
      <stop offset="50%" style="stop-color:#4facfe;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#00f2fe;stop-opacity:0.9" />
    </linearGradient>
    <filter id="glow72">
      <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="72" height="72" rx="16" fill="url(#spaceGradient72)" opacity="0.1"/>
  
  <!-- Outer ring -->
  <circle cx="36" cy="36" r="30" fill="none" stroke="url(#spaceGradient72)" stroke-width="2" opacity="0.4"/>
  
  <!-- Main sacred geometry -->
  <g transform="translate(36, 36)">
    <!-- Hexagon core -->
    <path d="M -12,-7 L 0,-14 L 12,-7 L 12,7 L 0,14 L -12,7 Z" 
          fill="url(#spaceGradient72)" opacity="0.7"/>
    
    <!-- Central consciousness core -->
    <circle cx="0" cy="0" r="6" fill="url(#consciousnessGlow72)" filter="url(#glow72)"/>
    <circle cx="0" cy="0" r="4" fill="#00f2fe" opacity="0.8"/>
    <circle cx="0" cy="0" r="2" fill="#ffffff" opacity="0.9"/>
    
    <!-- Orbital nodes -->
    <circle cx="-12" cy="-7" r="3" fill="#00f2fe" opacity="0.8"/>
    <circle cx="12" cy="-7" r="3" fill="#4facfe" opacity="0.8"/>
    <circle cx="12" cy="7" r="3" fill="#667eea" opacity="0.8"/>
    <circle cx="-12" cy="7" r="3" fill="#764ba2" opacity="0.8"/>
    <circle cx="0" cy="14" r="3" fill="#f093fb" opacity="0.8"/>
    <circle cx="0" cy="-14" r="3" fill="#f093fb" opacity="0.8"/>
    
    <!-- Neural connections -->
    <line x1="0" y1="0" x2="-12" y2="-7" stroke="url(#consciousnessGlow72)" stroke-width="1" opacity="0.5"/>
    <line x1="0" y1="0" x2="12" y2="-7" stroke="url(#consciousnessGlow72)" stroke-width="1" opacity="0.5"/>
    <line x1="0" y1="0" x2="12" y2="7" stroke="url(#consciousnessGlow72)" stroke-width="1" opacity="0.5"/>
    <line x1="0" y1="0" x2="-12" y2="7" stroke="url(#consciousnessGlow72)" stroke-width="1" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="14" stroke="url(#consciousnessGlow72)" stroke-width="1" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="-14" stroke="url(#consciousnessGlow72)" stroke-width="1" opacity="0.5"/>
  </g>
</svg>
