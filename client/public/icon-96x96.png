<svg width="96" height="96" viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spaceGradient96" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#764ba2;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fecfef;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="consciousnessGlow96" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00f2fe;stop-opacity:0.9" />
      <stop offset="50%" style="stop-color:#4facfe;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#00f2fe;stop-opacity:0.9" />
    </linearGradient>
    <filter id="glow96">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="96" height="96" rx="22" fill="url(#spaceGradient96)" opacity="0.1"/>
  
  <!-- Outer ring -->
  <circle cx="48" cy="48" r="40" fill="none" stroke="url(#spaceGradient96)" stroke-width="2" opacity="0.4"/>
  
  <!-- Main sacred geometry -->
  <g transform="translate(48, 48)">
    <!-- Hexagon core -->
    <path d="M -16,-9 L 0,-18 L 16,-9 L 16,9 L 0,18 L -16,9 Z" 
          fill="url(#spaceGradient96)" opacity="0.7"/>
    
    <!-- Central consciousness core -->
    <circle cx="0" cy="0" r="8" fill="url(#consciousnessGlow96)" filter="url(#glow96)"/>
    <circle cx="0" cy="0" r="5" fill="#00f2fe" opacity="0.8"/>
    <circle cx="0" cy="0" r="3" fill="#ffffff" opacity="0.9"/>
    
    <!-- Orbital nodes -->
    <circle cx="-16" cy="-9" r="4" fill="#00f2fe" opacity="0.8"/>
    <circle cx="16" cy="-9" r="4" fill="#4facfe" opacity="0.8"/>
    <circle cx="16" cy="9" r="4" fill="#667eea" opacity="0.8"/>
    <circle cx="-16" cy="9" r="4" fill="#764ba2" opacity="0.8"/>
    <circle cx="0" cy="18" r="4" fill="#f093fb" opacity="0.8"/>
    <circle cx="0" cy="-18" r="4" fill="#f093fb" opacity="0.8"/>
    
    <!-- Neural connections -->
    <line x1="0" y1="0" x2="-16" y2="-9" stroke="url(#consciousnessGlow96)" stroke-width="1.5" opacity="0.5"/>
    <line x1="0" y1="0" x2="16" y2="-9" stroke="url(#consciousnessGlow96)" stroke-width="1.5" opacity="0.5"/>
    <line x1="0" y1="0" x2="16" y2="9" stroke="url(#consciousnessGlow96)" stroke-width="1.5" opacity="0.5"/>
    <line x1="0" y1="0" x2="-16" y2="9" stroke="url(#consciousnessGlow96)" stroke-width="1.5" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="18" stroke="url(#consciousnessGlow96)" stroke-width="1.5" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="-18" stroke="url(#consciousnessGlow96)" stroke-width="1.5" opacity="0.5"/>
  </g>
</svg>
