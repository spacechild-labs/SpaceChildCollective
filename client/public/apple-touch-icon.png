<svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spaceGradient180" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#764ba2;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fecfef;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="consciousnessGlow180" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00f2fe;stop-opacity:0.9" />
      <stop offset="50%" style="stop-color:#4facfe;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#00f2fe;stop-opacity:0.9" />
    </linearGradient>
    <filter id="glow180">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="softGlow">
      <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background with subtle gradient -->
  <rect width="180" height="180" rx="40" fill="url(#spaceGradient180)" opacity="0.1"/>
  
  <!-- Outer ring representing collective consciousness -->
  <circle cx="90" cy="90" r="80" fill="none" stroke="url(#spaceGradient180)" stroke-width="3" opacity="0.4"/>
  
  <!-- Middle sacred geometry pattern -->
  <g transform="translate(90, 90)">
    <!-- Hexagon core (sacred geometry) -->
    <path d="M -30,-17.5 L 0,-35 L 30,-17.5 L 30,17.5 L 0,35 L -30,17.5 Z" 
          fill="url(#spaceGradient180)" opacity="0.3" filter="url(#softGlow)"/>
    
    <!-- Inner hexagon -->
    <path d="M -20,-11.5 L 0,-23 L 20,-11.5 L 20,11.5 L 0,23 L -20,11.5 Z" 
          fill="url(#spaceGradient180)" opacity="0.6"/>
    
    <!-- Central consciousness core -->
    <circle cx="0" cy="0" r="12" fill="url(#consciousnessGlow180)" filter="url(#glow180)"/>
    <circle cx="0" cy="0" r="8" fill="#00f2fe" opacity="0.8"/>
    <circle cx="0" cy="0" r="4" fill="#ffffff" opacity="0.9"/>
    
    <!-- Orbital consciousness nodes -->
    <circle cx="-30" cy="-17.5" r="8" fill="#00f2fe" opacity="0.8" filter="url(#glow180)"/>
    <circle cx="30" cy="-17.5" r="8" fill="#4facfe" opacity="0.8" filter="url(#glow180)"/>
    <circle cx="30" cy="17.5" r="8" fill="#667eea" opacity="0.8" filter="url(#glow180)"/>
    <circle cx="-30" cy="17.5" r="8" fill="#764ba2" opacity="0.8" filter="url(#glow180)"/>
    <circle cx="0" cy="35" r="8" fill="#f093fb" opacity="0.8" filter="url(#glow180)"/>
    <circle cx="0" cy="-35" r="8" fill="#f093fb" opacity="0.8" filter="url(#glow180)"/>
    
    <!-- Neural network connections -->
    <line x1="0" y1="0" x2="-30" y2="-17.5" stroke="url(#consciousnessGlow180)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="30" y2="-17.5" stroke="url(#consciousnessGlow180)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="30" y2="17.5" stroke="url(#consciousnessGlow180)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="-30" y2="17.5" stroke="url(#consciousnessGlow180)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="35" stroke="url(#consciousnessGlow180)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="-35" stroke="url(#consciousnessGlow180)" stroke-width="2" opacity="0.5"/>
    
    <!-- Inter-node connections -->
    <line x1="-30" y1="-17.5" x2="0" y2="-35" stroke="url(#consciousnessGlow180)" stroke-width="1" opacity="0.3"/>
    <line x1="30" y1="-17.5" x2="0" y2="-35" stroke="url(#consciousnessGlow180)" stroke-width="1" opacity="0.3"/>
    <line x1="30" y1="17.5" x2="0" y2="35" stroke="url(#consciousnessGlow180)" stroke-width="1" opacity="0.3"/>
    <line x1="-30" y1="17.5" x2="0" y2="35" stroke="url(#consciousnessGlow180)" stroke-width="1" opacity="0.3"/>
  </g>
  
  <!-- Outer orbital rings -->
  <circle cx="90" cy="90" r="60" fill="none" stroke="url(#consciousnessGlow180)" stroke-width="1" opacity="0.3"/>
  <circle cx="90" cy="90" r="70" fill="none" stroke="url(#consciousnessGlow180)" stroke-width="1" opacity="0.2"/>
  
  <!-- Subtle energy particles -->
  <circle cx="45" cy="45" r="2" fill="#00f2fe" opacity="0.6"/>
  <circle cx="135" cy="45" r="2" fill="#4facfe" opacity="0.6"/>
  <circle cx="135" cy="135" r="2" fill="#667eea" opacity="0.6"/>
  <circle cx="45" cy="135" r="2" fill="#764ba2" opacity="0.6"/>
</svg>
