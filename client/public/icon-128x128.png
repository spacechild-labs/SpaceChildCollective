<svg width="128" height="128" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="spaceGradient128" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#764ba2;stop-opacity:1" />
      <stop offset="70%" style="stop-color:#f093fb;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fecfef;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="consciousnessGlow128" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00f2fe;stop-opacity:0.9" />
      <stop offset="50%" style="stop-color:#4facfe;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#00f2fe;stop-opacity:0.9" />
    </linearGradient>
    <filter id="glow128">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="128" height="128" rx="28" fill="url(#spaceGradient128)" opacity="0.1"/>
  
  <!-- Outer ring -->
  <circle cx="64" cy="64" r="56" fill="none" stroke="url(#spaceGradient128)" stroke-width="3" opacity="0.4"/>
  
  <!-- Main sacred geometry -->
  <g transform="translate(64, 64)">
    <!-- Hexagon core -->
    <path d="M -22,-12.5 L 0,-25 L 22,-12.5 L 22,12.5 L 0,25 L -22,12.5 Z" 
          fill="url(#spaceGradient128)" opacity="0.7"/>
    
    <!-- Central consciousness core -->
    <circle cx="0" cy="0" r="12" fill="url(#consciousnessGlow128)" filter="url(#glow128)"/>
    <circle cx="0" cy="0" r="8" fill="#00f2fe" opacity="0.8"/>
    <circle cx="0" cy="0" r="4" fill="#ffffff" opacity="0.9"/>
    
    <!-- Orbital nodes -->
    <circle cx="-22" cy="-12.5" r="6" fill="#00f2fe" opacity="0.8"/>
    <circle cx="22" cy="-12.5" r="6" fill="#4facfe" opacity="0.8"/>
    <circle cx="22" cy="12.5" r="6" fill="#667eea" opacity="0.8"/>
    <circle cx="-22" cy="12.5" r="6" fill="#764ba2" opacity="0.8"/>
    <circle cx="0" cy="25" r="6" fill="#f093fb" opacity="0.8"/>
    <circle cx="0" cy="-25" r="6" fill="#f093fb" opacity="0.8"/>
    
    <!-- Neural connections -->
    <line x1="0" y1="0" x2="-22" y2="-12.5" stroke="url(#consciousnessGlow128)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="22" y2="-12.5" stroke="url(#consciousnessGlow128)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="22" y2="12.5" stroke="url(#consciousnessGlow128)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="-22" y2="12.5" stroke="url(#consciousnessGlow128)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="25" stroke="url(#consciousnessGlow128)" stroke-width="2" opacity="0.5"/>
    <line x1="0" y1="0" x2="0" y2="-25" stroke="url(#consciousnessGlow128)" stroke-width="2" opacity="0.5"/>
  </g>
</svg>
