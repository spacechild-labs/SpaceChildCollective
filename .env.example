# SpaceChildCollective Environment Configuration
# Copy to .env (which is gitignored) and fill in real values.
# In production the server fails fast at boot if required secrets are missing or weak.

# ── Core (required) ───────────────────────────────────────────────────────────
NODE_ENV="development"                 # "production" enforces strong secrets + secure cookies
PORT="5000"
# Postgres connection (Neon serverless in prod, or local Postgres in dev)
DATABASE_URL="postgresql://username:password@localhost:5432/spacechild_collective"

# ── Secrets (required in production; must be unique & >= 32 random chars) ──────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-32+-random-chars"     # signs session cookies
MCP_TOKEN_SECRET="change-me-32+-random-chars"   # HMAC key for agent MCP tokens
ENCRYPTION_KEY="change-me-32+-random-chars"     # AES-256-GCM key for stored AI provider keys

# ── Auth SSO (frontend) ───────────────────────────────────────────────────────
VITE_SPACE_CHILD_AUTH_URL="https://space-child-dream.replit.app"

# ── AI integrations (optional — features degrade gracefully if unset) ─────────
AI_INTEGRATIONS_OPENAI_BASE_URL=""
AI_INTEGRATIONS_OPENAI_API_KEY=""
PARALLEL_API_KEY=""                    # Parallel AI web research (platform.parallel.ai)

# ── Blockchain publishing (optional; server-held keys — NEVER sent by clients) ─
# The platform signs paper-publication transactions with these keys.
BLOCKCHAIN_PRIVATE_KEY=""              # fallback key for both chains
NEOX_PRIVATE_KEY=""                    # overrides BLOCKCHAIN_PRIVATE_KEY for NEO X
BASE_PRIVATE_KEY=""                    # overrides BLOCKCHAIN_PRIVATE_KEY for Base
# Network endpoints (defaults target the values originally hardcoded;
# NOTE: the default NEO X host is the T4 TESTNET — set a mainnet RPC for production).
NEOX_RPC="https://mainnet.neoxt4.neo.org"
NEOX_CHAIN_ID="47763"
BASE_RPC="https://mainnet.base.org"
BASE_CHAIN_ID="8453"

# ── Background jobs ───────────────────────────────────────────────────────────
ENABLE_TASK_DISPATCHER="false"        # "true" to poll for queued agent tasks
